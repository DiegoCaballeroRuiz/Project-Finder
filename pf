#!/bin/env bash

#############
# VARIABLES #
#############

# This is used for relative paths
PF_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# These can be changed based on personal preference
PROJECTS_DATABASE=$PF_DIR/projects_file # File containing the project database
PROJECT_ADD_BASE_DIR=$PWD # File where pf will look for directories when using pf add

#################
# FUNCTIONALITY #
#################

function connect() { # DIR, SESSION
    [[ ! $(tmux has-session -t "$2" 2>/dev/null) ]] && tmux new-session -d -s "$2" -c "$1"
    [[ -n "$TMUX" ]] && tmux switch-client -t "$2" || tmux attach-session -t "$2"
}

function set_dir() {
    [[ $1 ]] && DIR="$(realpath  $1)" || \
        {
            DIR=$(find $PROJECT_ADD_BASE_DIR -type d -print | sed "s|^$PROJECT_ADD_BASE_DIR||" | fzf --prompt="Choose project directory: ") 
            [[ $DIR ]] && DIR="$PROJECT_ADD_BASE_DIR$DIR" || exit 0
        }
    [[ -d "$DIR" ]] || { echo "$DIR is not a directory"; exit 1; }
}

function search() {
    [[ ! -s "$PROJECTS_DATABASE" ]] && { echo "No projects stored! Try adding some with pf add or read pf help"; return; }

    CHOICE=$(fzf --prompt="Choose a project: " < $PROJECTS_DATABASE)
    [[ ! $CHOICE ]] && return

    DIR=$(echo $CHOICE | cut -d @ -f 2)
    SESSION=$(echo $CHOICE | cut -d @ -f 1)

    connect $DIR $SESSION
}

function add() {
    set_dir $1

    [[ $2 ]] && SESSION=$2 || \
        {
            echo "Choose session name for the project: "
            read SESSION
        }

    [[ ! $SESSION ]] && { echo "Session name is empty. Aborting now"; return; }
    SESSION=$(echo $SESSION | tr . _)

    echo $SESSION@$DIR >> $PROJECTS_DATABASE
    echo "$SESSION added to projects"
}

function remove() {
    [[ $1 ]] && PATTERN=$1 || \
        PATTERN=$(fzf --prompt="Choose a project to delete: " < $PROJECTS_DATABASE) && [[ ! $PATTERN ]] && return;

    sed -i "\#$PATTERN#d" $PROJECTS_DATABASE
    echo "$(echo $PATTERN | cut -d @ -f 1) removed from projects"
}

function auto() {
    set_dir $1
    SESSION=$(basename $DIR | tr . _)
    add $DIR $SESSION
    connect $DIR $SESSION
}

function temp() {
    set_dir $1
    SESSION=$(basename $DIR | tr . _)
    connect $PWD $SESSION
}

function printHelpMessage() {
    cat <<- "EOF"
Project-Finder (pf) is a tool to reduce friction with tmux sessions via fzf and a plain text project database. Stored projects are formatted like so: <projectName>@<projectDir>

FLAGS:
  pf add (projectDirectory) (projectName):
    fzf from $PROJECT_ADD_BASE_DIR to search a project dir and add it to the database. After that, choose the project's name, it will be used as the tmux session name
    it is also possible to manually set the directory or both parameters

  pf remove (projectName):
    fuzilly find or specify a project name to permanently remove it from the database

  pf auto (projectDirectory):
    fzf from $PROJECT_ADD_BASE_DIR to search a project dir. Automatically add it to the projects database, with its base name as the session name. Attach to the new project afterwards
    it is also possible to manually set the directory

  pf temp (projectDirectory):
    fzf from $PROJECT_ADD_BASE_DIR to search a project dir. Automatically attach to it with its base name as the session name, WITHOUT adding it to the projects database
    it is also possible to manually set the directory

  pf (find):
    'find' is not mandatory. fuzilly find a project to connect to using tmux sessions

  pf help:
    print this message
EOF
}

function usage() {
    echo $1 is not a valid pf subcommand
    echo "Usage: pf (find), pf add (projectDirectory) (projectName), pf remove, pf auto, pf temp, pf help"
}

##############
# USER INPUT #
##############

CMD="${1,,}"
case "$CMD" in
    ""|"find") search ;;
    "add") add $2 $3 ;;
    "remove") remove $2 ;;
    "auto") auto $2 ;;
    "temp") temp $2 ;;
    "help"|"-h"|"--help") printHelpMessage ;;
    *) usage $1 ;;
esac
